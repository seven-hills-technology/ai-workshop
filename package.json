{
  "name": "ai-workshop",
  "version": "0.0.1",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm run dev --workspace @workshop/api",
    "dev:web": "npm run dev --workspace @workshop/web",
    "build": "npm-run-all --parallel build:api build:web",
    "build:api": "npm run build --workspace @workshop/api",
    "build:web": "npm run build --workspace @workshop/web"
  },
  "overrides": {
    "rxjs": "$rxjs"
  },
  "dependencies": {
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
